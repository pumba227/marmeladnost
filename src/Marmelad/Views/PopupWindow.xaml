<Window x:Class="Marmelad.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мармеладность: перевод"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" MinWidth="300" MaxWidth="480"
        Background="Transparent" UseLayoutRounding="True"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Skeleton" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.8" Duration="0:0:0.6" />
        </Storyboard>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.PopupBg}">
        <StackPanel x:Name="Body" Margin="14,8,8,14">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="BodyShift" />
            </StackPanel.RenderTransform>

            <DockPanel Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                            ToolTip="Скопировать перевод" Click="Copy_Click" />
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Content="&#xE718;"
                                  ToolTip="Не закрывать окно" Click="Pin_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                            ToolTip="Закрыть (Esc)" Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SourceLanguage" FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                               Text="Распознаю текст…" />
                    <StackPanel x:Name="LanguageArrow" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource Font.Icons}" FontSize="9"
                                   Margin="7,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Muted}" />
                        <TextBlock x:Name="TargetLanguage" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <StackPanel Margin="0,4,6,0">
                <TextBox x:Name="SourceBox" Style="{StaticResource PlainTextBox}" Visibility="Collapsed"
                         Foreground="{DynamicResource Brush.Muted}" AcceptsReturn="True"
                         ToolTip="Текст можно исправить, перевод обновится сам"
                         TextChanged="SourceBox_TextChanged" />

                <Border x:Name="Divider" Height="1" Margin="0,8" Visibility="Collapsed"
                        Background="{DynamicResource Brush.Border}" />

                <StackPanel x:Name="Skeleton">
                    <Border Height="14" Width="230" HorizontalAlignment="Left" CornerRadius="5"
                            Background="{DynamicResource Brush.Hover}" Margin="0,4,0,8" />
                    <Border Height="14" Width="150" HorizontalAlignment="Left" CornerRadius="5"
                            Background="{DynamicResource Brush.Hover}" />
                </StackPanel>

                <TextBox x:Name="ResultBox" Style="{StaticResource PlainTextBox}" IsReadOnly="True"
                         Visibility="Collapsed" FontWeight="SemiBold" />

                <ItemsControl x:Name="DictionaryList" Visibility="Collapsed" Focusable="False" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding PartOfSpeech}" FontSize="11"
                                           Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock Text="{Binding TermsText}" FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="MessagePanel" Visibility="Collapsed">
                    <TextBlock x:Name="MessageTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{DynamicResource Brush.Muted}" />
                    <Button x:Name="RetryButton" Style="{StaticResource SoftButton}" Content="Повторить"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="Retry_Click" />
                </StackPanel>

                <TextBlock x:Name="ProviderNote" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource Brush.Muted}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
