<Window x:Class="Marmelad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Marmelad.Views"
        Title="Мармеладность: настройки"
        Width="600" Height="780" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <views:EnumEqualsConverter x:Key="EnumEquals" />
        <views:ScaleConverter x:Key="Scale" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="5">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/logo.png" />
                    </Border.Background>
                </Border>
                <TextBlock Text="Мармеладность" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="Свернуть"
                        Click="Minimize_Click" />
                <Button Style="{StaticResource TitleCloseButton}" Content="&#xE8BB;"
                        ToolTip="Закрыть (программа останется в трее)" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="20,6,20,16">

                <!-- Hotkey -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <views:SettingRow Title="Горячая клавиша" Hint="Нажмите её в любой программе и выделите текст">
                            <Button x:Name="HotkeyButton" Style="{StaticResource SoftButton}" Padding="10,6"
                                    MinWidth="150" ToolTip="Нажмите, чтобы задать другое сочетание"
                                    Click="HotkeyButton_Click" LostKeyboardFocus="HotkeyButton_LostFocus">
                                <Grid>
                                    <ItemsControl x:Name="HotkeyCaps" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.Card}"
                                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                        CornerRadius="5" Padding="8,2" Margin="2,0">
                                                    <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="HotkeyPrompt" Text="Нажмите сочетание…" FontSize="13"
                                               Visibility="Collapsed" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Grid>
                            </Button>
                        </views:SettingRow>
                        <TextBlock x:Name="HotkeyError" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                                   Foreground="#E5484D" Margin="0,0,0,6" />
                    </StackPanel>
                </Border>

                <!-- Translation -->
                <TextBlock Text="ПЕРЕВОД" Style="{StaticResource CardTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <views:SettingRow Title="Переводить на">
                            <ComboBox x:Name="TargetCombo" DisplayMemberPath="Name" SelectedValuePath="Code"
                                      SelectedValue="{Binding TargetLanguage}" />
                        </views:SettingRow>
                        <views:SettingRow Title="Если текст уже на этом языке" Hint="Тогда перевод пойдёт на другой язык">
                            <ComboBox x:Name="FallbackCombo" DisplayMemberPath="Name" SelectedValuePath="Code"
                                      SelectedValue="{Binding FallbackLanguage}" />
                        </views:SettingRow>
                        <views:SettingRow Title="Язык текста на экране">
                            <ComboBox x:Name="OcrCombo" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding OcrLanguage}" />
                        </views:SettingRow>
                        <StackPanel Margin="0,2,0,6">
                            <TextBlock x:Name="OcrInstalled" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Muted}" />
                            <Button Style="{StaticResource LinkButton}" Content="Добавить язык в Windows"
                                    HorizontalAlignment="Left" Margin="0,3,0,0" Click="AddLanguage_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource CardTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <views:SettingRow Title="Тема">
                            <Border Background="{DynamicResource Brush.Control}" CornerRadius="8" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Как в Windows" GroupName="Theme"
                                                 IsChecked="{Binding ThemeMode, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Тёмная" GroupName="Theme"
                                                 IsChecked="{Binding ThemeMode, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Светлая" GroupName="Theme"
                                                 IsChecked="{Binding ThemeMode, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                                </StackPanel>
                            </Border>
                        </views:SettingRow>
                        <views:SettingRow Title="Цвет">
                            <ListBox x:Name="AccentList" Style="{StaticResource SwatchList}"
                                     SelectedValuePath="Hex" SelectedValue="{Binding Accent}" />
                        </views:SettingRow>
                        <views:SettingRow Title="Размер текста">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TextSize}" FontSize="12.5" Width="30" TextAlignment="Right"
                                           Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Muted}" />
                                <Slider Minimum="12" Maximum="24" TickFrequency="1" Value="{Binding TextSize}" />
                            </StackPanel>
                        </views:SettingRow>
                        <views:SettingRow Title="Прозрачность окна" Hint="Фон размывается, текст остаётся чётким">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12.5" Width="30" TextAlignment="Right" Margin="0,0,10,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"
                                           Text="{Binding Transparency, StringFormat={}{0}%}" />
                                <Slider Minimum="0" Maximum="60" TickFrequency="5" Value="{Binding Transparency}" />
                            </StackPanel>
                        </views:SettingRow>

                        <!-- Live preview of the translation card -->
                        <Border CornerRadius="10" Padding="22,16" Margin="0,8,0,6"
                                Background="{DynamicResource Brush.PreviewBackdrop}">
                            <Border Background="{DynamicResource Brush.PopupBg}" CornerRadius="8" Padding="14,10"
                                    HorizontalAlignment="Center" MinWidth="280">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Английский" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
                                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource Font.Icons}" FontSize="9"
                                                   Margin="7,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Muted}" />
                                        <TextBlock Text="Русский" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowSource, Converter={StaticResource BoolToVisibility}}"
                                                Margin="0,6,0,0">
                                        <TextBlock Text="Sweet marmalade" Foreground="{DynamicResource Brush.Muted}"
                                                   FontSize="{Binding TextSize, Converter={StaticResource Scale}, ConverterParameter=0.88}" />
                                        <Border Height="1" Margin="0,8,0,0" Background="{DynamicResource Brush.Border}" />
                                    </StackPanel>
                                    <TextBlock Text="Сладкий мармелад" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Foreground="{DynamicResource Brush.Text}"
                                               FontSize="{Binding TextSize, Converter={StaticResource Scale}, ConverterParameter=1.07}" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Popup behaviour -->
                <TextBlock Text="ОКНО ПЕРЕВОДА" Style="{StaticResource CardTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <views:SettingRow Title="Где показывать" Hint="Если места не хватит, окно встанет с другой стороны">
                            <ComboBox x:Name="SideCombo" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding PopupSide}" />
                        </views:SettingRow>
                        <views:SettingRow Title="Закрывать автоматически">
                            <ComboBox x:Name="AutoCloseCombo" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding AutoCloseSeconds}" />
                        </views:SettingRow>
                        <views:SettingRow Title="Показывать распознанный текст" Hint="Его можно исправить прямо в окне">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowSource}" />
                        </views:SettingRow>
                        <views:SettingRow Title="Закрывать при клике мимо окна">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseOnClickOutside}" />
                        </views:SettingRow>
                        <views:SettingRow Title="Сразу копировать перевод">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoCopy}" />
                        </views:SettingRow>
                    </StackPanel>
                </Border>

                <!-- System -->
                <Border Style="{StaticResource Card}" Margin="0">
                    <views:SettingRow Title="Запускать вместе с Windows"
                                      Hint="Если закрыть это окно, программа останется работать в трее">
                        <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}"
                                  Click="AutostartSwitch_Click" />
                    </views:SettingRow>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
